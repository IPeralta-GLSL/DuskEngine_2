// RTShadowComposite.azsl
//
// Shadow-replacement compositing pass: runs after SSAO and before DiffuseSpecularMerge.
// Blends the RT-denoised directional shadow into the diffuse buffer using a
// multiplicative NdotL-weighted ratio: diffuseOut = diffuseIn * lerp(1, rtShadow/csmShadow, NdotL).
// This requires no albedo buffer and is stable when csmShadow approaches zero.

#include <scenesrg_all.srgi>
#include <viewsrg_all.srgi>
#include <Atom/RPI/Math.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>

#include <Atom/Features/RayTracingShadows/RTShadowCompositeSrg.srgi>

float4 MainPS(VSOutput IN) : SV_Target0
{
    int2 coord = int2(IN.m_position.xy);

    float3 diffuse  = PassSrg::m_diffuse.Load(int3(coord, 0)).rgb;
    float csmShadow = PassSrg::m_csmShadow.Load(int3(coord, 0)).r;
    float rtShadow  = PassSrg::m_rtShadow.Load(int3(coord, 0)).r;

    if (abs(rtShadow - csmShadow) > 0.01f && SceneSrg::m_directionalLightCount > 0)
    {
        float3 encodedNormal = PassSrg::m_normal.Load(coord, 0).rgb;
        float3 normal = DecodeNormalSignedOctahedron(encodedNormal);
        float3 dirToLight = -normalize(SceneSrg::m_directionalLights[0].m_direction);
        float NdotL = saturate(dot(normal, dirToLight));

        if (NdotL > 0.01f)
        {
            // Scale diffuse by rtShadow/csmShadow, weighted by NdotL.
            // Clamp ratio to 2× to prevent over-brightening very dark CSM pixels.
            float ratio = clamp(rtShadow / max(csmShadow, 0.001f), 0.0f, 2.0f);
            float blendWeight = saturate(NdotL * 2.0f);
            float correction = lerp(1.0f, ratio, blendWeight);
            diffuse *= correction;
        }
    }

    return float4(diffuse, 1.0f);
}
