#include "RayTracingEmissiveCommon.azsli"
#include <Atom/RPI/Math.azsli>

uint WangHash(uint seed)
{
    seed = (seed ^ 61u) ^ (seed >> 16u);
    seed *= 9u;
    seed = seed ^ (seed >> 4u);
    seed *= 0x27d4eb2du;
    seed = seed ^ (seed >> 15u);
    return seed;
}

float RandFloat(inout uint seed)
{
    seed = WangHash(seed);
    return float(seed) / 4294967295.0f;
}

float3 CosineWeightedHemisphere(float2 xi, float3 normal)
{
    float phi = 2.0f * 3.14159265f * xi.x;
    float cosTheta = sqrt(1.0f - xi.y);
    float sinTheta = sqrt(xi.y);

    float3 localDir = float3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

    float3 up = abs(normal.z) < 0.999f ? float3(0, 0, 1) : float3(1, 0, 0);
    float3 tangent = normalize(cross(up, normal));
    float3 bitangent = cross(normal, tangent);

    return normalize(tangent * localDir.x + bitangent * localDir.y + normal * localDir.z);
}

[shader("raygeneration")]
void RayGeneration()
{
    uint2 pixelCoords = DispatchRaysIndex().xy;
    uint2 dimensions = DispatchRaysDimensions().xy;
    float2 UV = (float2)pixelCoords / dimensions;

    float depth = RayTracingGlobalSrg::m_depth.Load(pixelCoords, 0);
    if (depth >= 1.0f)
    {
        RayTracingGlobalSrg::m_emissiveOutput[pixelCoords] = float4(0, 0, 0, 0);
        return;
    }

    float2 ndcPos = float2(UV.x, 1.0f - UV.y) * 2.0f - 1.0f;
    float4 projectedPos = float4(ndcPos, depth, 1.0f);
    float4 positionVS = mul(ViewSrg::m_projectionMatrixInverse, projectedPos);
    positionVS /= positionVS.w;
    float4 positionWS = mul(ViewSrg::m_viewMatrixInverse, positionVS);

    float4 encodedNormal = RayTracingGlobalSrg::m_normal.Load(pixelCoords, 0);
    float3 normalWS = DecodeNormalSignedOctahedron(encodedNormal.rgb);

    float3 origin = positionWS.xyz + normalWS * 0.001f;
    float3 accumulatedEmissive = float3(0, 0, 0);
    uint rngSeed = pixelCoords.x + pixelCoords.y * dimensions.x + asuint(ViewSrg::m_worldPosition.x);

    uint sampleCount = max(1u, RayTracingGlobalSrg::m_emissiveSampleCount);
    for (uint i = 0; i < sampleCount; ++i)
    {
        rngSeed = WangHash(rngSeed + i);
        float2 xi = float2(RandFloat(rngSeed), RandFloat(rngSeed));
        float3 sampleDir = CosineWeightedHemisphere(xi, normalWS);

        RayDesc ray;
        ray.Origin = origin;
        ray.Direction = sampleDir;
        ray.TMin = 0.0f;
        ray.TMax = RayTracingGlobalSrg::m_emissiveMaxRayLength;

        EmissivePayload payload;
        payload.m_emissiveColor = float3(0, 0, 0);
        payload.m_hitT = -1.0f;
        TraceRay(RayTracingSceneSrg::m_scene, RAY_FLAG_CULL_BACK_FACING_TRIANGLES, 0xFF, 0, 1, 0, ray, payload);

        if (payload.m_hitT > 0.0f)
        {
            float falloff = 1.0f / (1.0f + payload.m_hitT * payload.m_hitT);
            accumulatedEmissive += payload.m_emissiveColor * falloff;
        }
    }

    accumulatedEmissive = (accumulatedEmissive / (float)sampleCount) * RayTracingGlobalSrg::m_emissiveIntensityScale;
    RayTracingGlobalSrg::m_emissiveOutput[pixelCoords] = float4(accumulatedEmissive, 1.0f);
}
