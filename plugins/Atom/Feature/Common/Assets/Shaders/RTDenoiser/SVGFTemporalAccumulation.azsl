#include <scenesrg_all.srgi>
#include <viewsrg_all.srgi>
#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>
#include <Atom/Features/PostProcessing/FullscreenPixelInfo.azsli>
#include <Atom/RPI/Math.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float4> m_currentColor;
    Texture2D<float4> m_historyColor;
    Texture2DMS<float> m_depth;
    Texture2DMS<float4> m_normal;

    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU  = Clamp;
        AddressV  = Clamp;
        AddressW  = Clamp;
    };
}

static const float MAX_TEMPORAL_WEIGHT = 0.95;

float LinearDepth(float hwDepth)
{
    float4 v = mul(ViewSrg::m_projectionMatrixInverse, float4(0.0, 0.0, hwDepth, 1.0));
    return abs(v.z / v.w);
}

float Luminance(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}

PSOutput MainPS(VSOutput IN)
{
    int2 icoords = int2(IN.m_position.xy);
    float2 uv = IN.m_texCoord.xy;

    float4 currentColor = PassSrg::m_currentColor.Load(int3(icoords, 0));
    float  currentLum = Luminance(currentColor.rgb);

    float  hwDepthCenter = PassSrg::m_depth.Load(icoords, 0).r;
    float3 normalCenter = DecodeNormalSignedOctahedron(PassSrg::m_normal.Load(icoords, 0).rgb);
    float  linearDepthCenter = LinearDepth(hwDepthCenter);

    float2 ndc = float2(uv.x, 1.0 - uv.y) * 2.0 - 1.0;
    float4 projPos = float4(ndc, hwDepthCenter, 1.0);
    float4 viewPos = mul(ViewSrg::m_projectionMatrixInverse, projPos);
    viewPos /= viewPos.w;
    float4 worldPos = mul(ViewSrg::m_viewMatrixInverse, viewPos);

    float4 prevClip = mul(ViewSrg::m_viewProjectionPrevMatrix, worldPos);
    prevClip /= prevClip.w;
    float2 prevUV = float2(prevClip.x * 0.5 + 0.5, -prevClip.y * 0.5 + 0.5);

    float3 outputColor = currentColor.rgb;
    float  outputVariance = 0.0;

    if (prevUV.x >= 0.0 && prevUV.x <= 1.0 && prevUV.y >= 0.0 && prevUV.y <= 1.0)
    {
        float4 historySample = PassSrg::m_historyColor.SampleLevel(PassSrg::LinearSampler, prevUV, 0);

        float3 neighborhoodMin = currentColor.rgb;
        float3 neighborhoodMax = currentColor.rgb;

        [unroll]
        for (int dy = -1; dy <= 1; ++dy)
        {
            [unroll]
            for (int dx = -1; dx <= 1; ++dx)
            {
                if (dx == 0 && dy == 0) continue;
                float3 nc = PassSrg::m_currentColor.Load(int3(icoords + int2(dx, dy), 0)).rgb;
                neighborhoodMin = min(neighborhoodMin, nc);
                neighborhoodMax = max(neighborhoodMax, nc);
            }
        }

        float3 extent = (neighborhoodMax - neighborhoodMin) * 0.5;
        float3 boxCenter = (neighborhoodMax + neighborhoodMin) * 0.5;
        float3 clampedHistory = clamp(historySample.rgb, boxCenter - extent, boxCenter + extent);

        float histLum = Luminance(historySample.rgb);
        float lumDiff = abs(currentLum - histLum);
        float histWeight = MAX_TEMPORAL_WEIGHT * (1.0 - lumDiff / max(currentLum + histLum, 1e-6));
        histWeight = max(histWeight, 0.0);

        outputColor = lerp(currentColor.rgb, clampedHistory, histWeight);

        float3 diff = currentColor.rgb - clampedHistory;
        outputVariance = dot(diff, diff);
    }

    PSOutput OUT;
    OUT.m_color = float4(outputColor, outputVariance);
    return OUT;
}
