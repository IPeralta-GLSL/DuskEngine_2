#pragma once

// The visibility buffer pass only writes object/primitive IDs; it performs no
// lighting. Strip material lighting features so every material type compiles
// (Skin/Eye/BasePBR lack the optional SurfaceData members these would add).
#define ENABLE_CLEAR_COAT 0
#define ENABLE_TRANSMISSION 0
#define ENABLE_PARALLAX 0

#include <Atom/Features/SrgSemantics.azsli>

#define MATERIALPIPELINE_SHADER_HAS_PIXEL_STAGE 1
#define PIPELINE_HAS_PASS_SRG 0

#ifdef MATERIAL_TYPE_DEFINES_AZSLI_FILE_PATH
#include MATERIAL_TYPE_DEFINES_AZSLI_FILE_PATH
#endif

#include <viewsrg_all.srgi>
#include <scenesrg_all.srgi>
#include <Atom/Features/Pipeline/Forward/ForwardPassVertexData.azsli>
#include <Atom/Features/Pipeline/Forward/ForwardPassPipelineCallbacks.azsli>

#include MATERIAL_TYPE_AZSLI_FILE_PATH

VsOutput VertexShader(VsInput IN, uint instanceId : SV_InstanceID)
{
    VsSystemValues SV;
    SV.m_instanceId = instanceId;
    VsOutput OUT = EvaluateVertexGeometry(IN, SV, GetMaterialParameters());
    OUT.m_instanceId = instanceId;
    return OUT;
}

struct VBufferPSOutput
{
    uint m_objectId : SV_Target0;
    uint m_primitiveId : SV_Target1;
};

VBufferPSOutput PixelShader(VsOutput IN, uint primitiveId : SV_PrimitiveID)
{
    VBufferPSOutput OUT;
    OUT.m_objectId = ObjectSrg::m_objectId;
    OUT.m_primitiveId = primitiveId;
    return OUT;
}
