#pragma once

#include <Atom/Features/SrgSemantics.azsli>

#define MATERIALPIPELINE_SHADER_HAS_PIXEL_STAGE 1

#include <scenesrg_all.srgi>
#include <viewsrg_all.srgi>
#include <Atom/Features/PBR/DefaultObjectSrg.azsli>
#include <Atom/RPI/ShaderResourceGroups/DefaultDrawSrg.azsli>
#include <Atom/Features/InstancedTransforms.azsli>

struct VBufferVSInput
{
    float3 m_position : POSITION;
};

struct VBufferVSOutput
{
    precise float4 m_position : SV_Position;
};

struct VBufferPSOutput
{
    uint m_objectId : SV_Target0;
    uint m_primitiveId : SV_Target1;
};

VBufferVSOutput VertexShader(VBufferVSInput IN, uint instanceId : SV_InstanceID)
{
    VBufferVSOutput OUT;
    float4x4 objectToWorld = GetObjectToWorldMatrix(instanceId);
    float4 worldPosition = mul(objectToWorld, float4(IN.m_position, 1.0));
    OUT.m_position = mul(ViewSrg::m_viewProjectionMatrix, worldPosition);
    return OUT;
}

VBufferPSOutput PixelShader(VBufferVSOutput IN, uint primitiveId : SV_PrimitiveID)
{
    VBufferPSOutput OUT;
    OUT.m_objectId = ObjectSrg::m_objectId;
    OUT.m_primitiveId = primitiveId;
    return OUT;
}
