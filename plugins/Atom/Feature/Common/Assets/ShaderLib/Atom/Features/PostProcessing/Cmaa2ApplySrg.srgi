#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float4> m_candidates;
    Texture2D<float4> m_sourceColor;

    Sampler PointSampler
    {
        MinFilter = Point;
        MagFilter = Point;
        MipFilter = Point;
        AddressU  = Clamp;
        AddressV  = Clamp;
        AddressW  = Clamp;
    };
}

