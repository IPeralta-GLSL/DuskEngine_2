#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float4> m_diffuseFrameBuffer;
    Texture2D<float4> m_specularFrameBuffer;
    
    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
}
