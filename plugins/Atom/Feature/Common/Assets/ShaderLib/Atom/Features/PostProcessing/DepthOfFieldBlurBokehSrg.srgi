#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass_WithFallback
{
    Texture2D<float4> m_colorAndDofFactorTexture;
    float m_radiusMin;
    float m_radiusMax;
    float4 m_sampleTexcoordsRadius[SampleMax];

    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
}
