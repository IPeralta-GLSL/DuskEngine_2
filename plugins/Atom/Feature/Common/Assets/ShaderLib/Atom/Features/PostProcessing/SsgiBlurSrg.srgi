#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float> m_depthLinear;
    Texture2D<float4> m_ssgi;
    RWTexture2D<float4> m_ssgiBlurred;

    Sampler PointSampler
    {
        MinFilter = Point;
        MagFilter = Point;
        MipFilter = Point;
        AddressU  = Clamp;
        AddressV  = Clamp;
        AddressW  = Clamp;
    };
}
