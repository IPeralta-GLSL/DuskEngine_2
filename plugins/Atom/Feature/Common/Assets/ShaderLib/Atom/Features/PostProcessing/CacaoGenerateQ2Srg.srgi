#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass_WithFallback
{
    Texture2DArray<float>       m_deinterleavedDepths;   // quarter-res, ArraySize=4
    RWTexture2DArray<float2>    m_aoBuffer;              // quarter-res, ArraySize=4

    Sampler m_pointSampler
    {
        MaxAnisotropy = 1;
        MinFilter     = Point;
        MagFilter     = Point;
        MipFilter     = Point;
        AddressU      = Clamp;
        AddressV      = Clamp;
        AddressW      = Clamp;
    };

    CacaoConstants m_constants;
}
