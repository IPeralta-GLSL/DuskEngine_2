#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass_WithFallback
{
    Texture2DArray<float2>      m_aoPing;    // Input:  AO + packed edges (ArraySize=4)
    RWTexture2DArray<float2>    m_aoPong;    // Output: blurred AO + edges (ArraySize=4)

    Sampler m_linearSampler
    {
        MaxAnisotropy = 1;
        MinFilter     = Linear;
        MagFilter     = Linear;
        MipFilter     = Point;
        AddressU      = Clamp;
        AddressV      = Clamp;
        AddressW      = Clamp;
    };

    CacaoConstants m_constants;
}
