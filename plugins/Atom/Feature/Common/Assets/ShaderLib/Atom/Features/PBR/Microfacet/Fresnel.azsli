#pragma once

// ------- Fresnel Functions -------

//! Calculate fresnel reflectance using the Schlick method.
//! Reference Naty Hoffman, "Background:  Physics and Math of Shading":  https://blog.selfshadow.com/publications/s2013-shading-course/hoffman/s2013_pbs_physics_math_notes.pdf  Page 16, (6)
//!
//! @param H   half vector (which coincides with the normal vector at microlevel) 
//! @param V   view vector (or light vector; the dot product is the same for both)
//! @param F0  the characteristic specular reflectance of the material. Also referred to it as specular color.
real3 FresnelSchlickF90(const real HdotV, const real3 F0, const real F90)
{
    // At angles where (View = Normal) the dot product HdotV is 1.0
    return F0 + (F90 - F0) * pow(1.0 - HdotV, 5.0);
}

real FresnelSchlickF90_1(const real HdotV, const real F0, const real F90)
{
    return F0 + (F90 - F0) * pow(1.0 - HdotV, 5.0);
}

real3 FresnelSchlick(const real HdotV, const real3 F0)
{
    return FresnelSchlickF90(HdotV, F0, 1.0);
}

real FresnelSchlick_1(const real HdotV, const real F0)
{
    return FresnelSchlickF90_1(HdotV, F0, 1.0);
}

//! Calculate fresnel reflectance using the Schlick method, taking roughness into account.
//! We need to take into account roughness with fresnel when sampling from an environment map,
//! as the halfway vector used to sample the BRDF (and generate the environment map) is also
//! influenced by roughness.
//! https://seblagarde.wordpress.com/2011/08/17/hello-world/
//!
//! @param N   surface normal
//! @param V   view vector (or light vector; the dot product is the same for both)
//! @param specularF0  the characteristic specular reflectance of the material. Also referred to it as specular color.
//! @param roughness  roughness value used to further attenuate the fresnel response. This is a "fudge factor" and may or may not be perceptually linear.
real3 FresnelSchlickWithRoughness(const real NdotV, const real3 specularF0, const real roughness)
{
    real smoothness = 1.0 - roughness;
    real3 F0 = specularF0;

    return F0 + (max(smoothness, F0) - F0) * pow(1.0 - saturate(NdotV), 5.0);
}

real FresnelSchlickWithRoughness_1(const real NdotV, const real specularF0, const real roughness)
{
    real smoothness = 1.0 - roughness;
    real F0 = specularF0;

    return F0 + (max(smoothness, F0) - F0) * pow(1.0 - saturate(NdotV), 5.0);
}

// Gulbrandsen 2014 - Artist Friendly Metallic Fresnel
// "Artist Friendly Metallic Fresnel", Ole Gulbrandsen, JCGT Vol.3 No.4, 2014
// http://jcgt.org/published/0003/04/03/
//
// Uses reflectivity (base reflectance at normal incidence) and edgeTint
// (color at grazing angle) instead of raw complex IOR (n, k).
// This gives artists intuitive control over metallic Fresnel behavior.

float3 GulbrandsenNMin(float3 r)
{
    return (1.0 - r) / (1.0 + r);
}

float3 GulbrandsenNMax(float3 r)
{
    float3 rSqrt = sqrt(r);
    return (1.0 + rSqrt) / (1.0 - rSqrt);
}

float3 GulbrandsenComputeEta(float3 reflectivity, float3 edgeTint)
{
    return edgeTint * GulbrandsenNMin(reflectivity) + (1.0 - edgeTint) * GulbrandsenNMax(reflectivity);
}

float3 GulbrandsenComputeK(float3 reflectivity, float3 eta)
{
    float3 a = eta + 1.0;
    float3 b = eta - 1.0;
    float3 nr = max(0.0, reflectivity * a * a - b * b);
    return sqrt(nr / max(1.0 - reflectivity, 1e-8));
}

float3 FresnelConductorGulbrandsen(float cosThetaI, float3 reflectivity, float3 edgeTint)
{
    float3 clampedReflectivity = clamp(reflectivity, 0.0, 0.999);
    float3 clampedEdgeTint = clamp(edgeTint, 0.0, 0.999);

    float3 eta = GulbrandsenComputeEta(clampedReflectivity, clampedEdgeTint);
    float3 k = GulbrandsenComputeK(clampedReflectivity, eta);

    float cosTheta = saturate(cosThetaI);
    float cosTheta2 = cosTheta * cosTheta;
    float sinTheta2 = 1.0 - cosTheta2;

    float3 eta2 = eta * eta;
    float3 k2 = k * k;

    float3 t0 = eta2 - k2 - sinTheta2;
    float3 a2plusb2 = sqrt(max(0.0, t0 * t0 + 4.0 * eta2 * k2));
    float3 t1 = a2plusb2 + cosTheta2;
    float3 a = sqrt(max(0.0, 0.5 * (a2plusb2 + t0)));
    float3 t2 = 2.0 * a * cosTheta;

    float3 Rs = (t1 - t2) / max(t1 + t2, 1e-8);
    float3 t3 = cosTheta2 * a2plusb2 + sinTheta2 * sinTheta2;
    float3 t4 = t2 * sinTheta2;
    float3 Rp = Rs * (t3 - t4) / max(t3 + t4, 1e-8);

    return 0.5 * (Rs + Rp);
}

float3 FresnelConductorSchlick(float HdotV, float3 F0, float3 F90)
{
    float t = 1.0 - HdotV;
    float t2 = t * t;
    float t5 = t2 * t2 * t;
    return F0 + (F90 - F0) * t5;
}


