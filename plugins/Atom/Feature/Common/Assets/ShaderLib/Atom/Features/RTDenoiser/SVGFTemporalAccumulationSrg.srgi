#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float4> m_currentColor;
    Texture2D<float4> m_historyColor;
    Texture2DMS<float> m_depth;
    Texture2DMS<float4> m_normal;

    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU  = Clamp;
        AddressV  = Clamp;
        AddressW  = Clamp;
    };
}
