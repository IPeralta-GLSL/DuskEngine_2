#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float4> m_color;
    Texture3D<float4> m_lut;
    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
    float m_shaperBias;
    float m_shaperScale;
}
