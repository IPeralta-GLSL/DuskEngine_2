#pragma once

#include <Atom/RPI/Math.azsli>

float DirectionalAlbedoGGX(float NdotV, float roughness)
{
    float4 c0 = float4(-1.0, -0.0275, -0.572, 0.022);
    float4 c1 = float4(1.0, 0.0425, 1.04, -0.04);
    float4 r = roughness * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * NdotV)) * r.x + r.y;
    return a004;
}

real3 EnergyCompensationPerLight(real NdotV, real NdotL, real roughness, real3 Favg)
{
    float Eo = DirectionalAlbedoGGX(saturate(NdotV), roughness);
    float Ei = DirectionalAlbedoGGX(saturate(NdotL), roughness);

    float oneMinusEavg = max(1.0 - (Eo + Ei) * 0.5, 1e-4);
    float compensation = (1.0 - Eo) * (1.0 - Ei) / oneMinusEavg;

    real3 Favg2 = Favg * Favg;
    float Eavg = 1.0 - oneMinusEavg;
    real3 multiplier = Favg2 * Eavg / max(real3(1.0, 1.0, 1.0) - Favg * (1.0 - Eavg), real3(1e-4, 1e-4, 1e-4));

    return compensation * multiplier * INV_PI;
}
