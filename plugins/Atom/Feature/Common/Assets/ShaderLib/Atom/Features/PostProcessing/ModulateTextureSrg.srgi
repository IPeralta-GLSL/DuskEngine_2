#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float> m_modifier;
    RWTexture2D<float4> m_inputOutput;

    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
}
