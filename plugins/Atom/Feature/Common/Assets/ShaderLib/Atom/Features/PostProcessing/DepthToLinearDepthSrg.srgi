#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass
{
    // D32_FLOAT_S8X24_UINT (Format:15) depthStencil texture
    Texture2D<float2> m_depthStencil;
    Sampler PointSampler
    {
        MinFilter = Point;
        MagFilter = Point;
        MipFilter = Point;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
}
