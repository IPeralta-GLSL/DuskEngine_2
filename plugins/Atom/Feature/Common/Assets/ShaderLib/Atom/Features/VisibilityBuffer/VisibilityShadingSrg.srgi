#pragma once

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<uint> m_objectId;
    Texture2D<uint> m_primitiveId;

    Sampler PointSampler
    {
        MinFilter = Point;
        MagFilter = Point;
        MipFilter = Point;
        AddressU  = Clamp;
        AddressV  = Clamp;
        AddressW  = Clamp;
    };
}
