{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "SsgiComputeTemplate",
            "PassClass": "SsgiComputePass",
            "Slots": [
                {
                    "Name": "DepthLinear",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader"
                },
                {
                    "Name": "Lighting",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader"
                },
                {
                    "Name": "Output",
                    "SlotType": "Output",
                    "ScopeAttachmentUsage": "Shader",
                    "LoadStoreAction": {
                        "LoadAction": "Clear",
                        "StoreAction": "Store"
                    }
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "SsgiTexture",
                    "SizeSource": {
                        "Source": {
                            "Pass": "This",
                            "Attachment": "DepthLinear"
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R16G16B16A16_FLOAT"
                    }
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "Output",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "SsgiTexture"
                    }
                }
            ],
            "PassData": {
                "$type": "ComputePassData",
                "ShaderAsset": {
                    "FilePath": "Shaders/PostProcessing/SsgiCompute.shader"
                },
                "FullscreenDispatch": true,
                "BindViewSrg": true
            }
        }
    }
}
