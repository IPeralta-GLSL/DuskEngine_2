{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "RayTracingEmissivePassTemplate",
            "PassClass": "RayTracingPass",
            "Slots": [
                {
                    "Name": "DepthStencilTextureInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader",
                    "ImageViewDesc": {
                        "AspectFlags": [
                            "Depth"
                        ]
                    }
                },
                {
                    "Name": "NormalInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader"
                },
                {
                    "Name": "EmissiveOutput",
                    "SlotType": "Output",
                    "ShaderInputName": "m_emissiveOutput",
                    "ScopeAttachmentUsage": "Shader",
                    "LoadStoreAction": {
                        "ClearValue": {
                            "Value": [
                                0.0,
                                0.0,
                                0.0,
                                0.0
                            ]
                        },
                        "LoadAction": "Clear"
                    }
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "EmissiveImage",
                    "SizeSource": {
                        "Source": {
                            "Pass": "This",
                            "Attachment": "DepthStencilTextureInput"
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R16G16B16A16_FLOAT",
                        "MultisampleState": {
                            "samples": 1
                        },
                        "SharedQueueMask": "Graphics"
                    }
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "EmissiveOutput",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "EmissiveImage"
                    }
                }
            ],
            "PassData": {
                "$type": "RayTracingPassData",
                "RayGenerationShaderAsset": { "FilePath": "Shaders/RayTracingEmissive/RayTracingEmissiveRayGeneration.shader" },
                "RayGenerationShaderName": "RayGeneration",
                "ClosestHitShaderAsset": { "FilePath": "Shaders/RayTracingEmissive/RayTracingEmissiveClosestHit.shader" },
                "ClosestHitShaderName": "ClosestHit",
                "ClosestHitProceduralShaderAsset": { "FilePath": "Shaders/RayTracingEmissive/RayTracingEmissiveClosestHitProcedural.shader" },
                "ClosestHitProceduralShaderName": "ClosestHitProcedural",
                "MissShaderAsset": { "FilePath": "Shaders/RayTracingEmissive/RayTracingEmissiveMiss.shader" },
                "MissShaderName": "Miss",
                "MaxPayloadSize": 16,
                "MaxRecursionDepth": 1,
                "FullscreenDispatch": true,
                "BindViewSrg": true
            }
        }
    }
}

