{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "ShadowDenoiserPassTemplate",
            "PassClass": "ShadowDenoiserPass",
            "Slots": [
                {
                    "Name": "DepthStencilTextureInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader",
                    "ImageViewDesc": {
                        "AspectFlags": [
                            "Depth"
                        ]
                    }
                },
                {
                    "Name": "NormalInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader"
                },
                {
                    "Name": "ShadowInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader"
                },
                {
                    "Name": "History",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader",
                    "LoadStoreAction": {
                        "LoadAction": "Load"
                    }
                },
                {
                    "Name": "Output",
                    "SlotType": "Output",
                    "ScopeAttachmentUsage": "RenderTarget",
                    "LoadStoreAction": {
                        "ClearValue": {
                            "Value": [
                                1.0,
                                1.0,
                                1.0,
                                1.0
                            ]
                        },
                        "LoadAction": "Clear"
                    }
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "DenoisedShadowImage",
                    "SizeSource": {
                        "Source": {
                            "Pass": "This",
                            "Attachment": "ShadowInput"
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R16G16B16A16_FLOAT",
                        "MultisampleState": {
                            "samples": 1
                        },
                        "SharedQueueMask": "Graphics"
                    }
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "Output",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "DenoisedShadowImage"
                    }
                }
            ],
            "PassData": {
                "$type": "FullscreenTrianglePassData",
                "ShaderAsset": {
                    "FilePath": "Shaders/RayTracingShadows/ShadowDenoiserFilter.shader"
                },
                "BindViewSrg": true
            }
        }
    }
}
