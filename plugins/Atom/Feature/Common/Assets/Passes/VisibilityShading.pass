{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "VisibilityShadingPassTemplate",
            "PassClass": "FullScreenTriangle",
            "Slots": [
                {
                    "Name": "ObjectIdInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader"
                },
                {
                    "Name": "PrimitiveIdInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader"
                },
                {
                    "Name": "Output",
                    "SlotType": "InputOutput",
                    "ScopeAttachmentUsage": "RenderTarget"
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "ObjectId",
                    "SizeSource": {
                        "Source": {
                            "Pass": "Parent",
                            "Attachment": "PipelineOutput"
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R32_UINT",
                        "BindFlags": "ShaderRead",
                        "SharedQueueMask": "Graphics"
                    }
                },
                {
                    "Name": "PrimitiveId",
                    "SizeSource": {
                        "Source": {
                            "Pass": "Parent",
                            "Attachment": "PipelineOutput"
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R32_UINT",
                        "BindFlags": "ShaderRead",
                        "SharedQueueMask": "Graphics"
                    }
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "ObjectIdInput",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "ObjectId"
                    }
                },
                {
                    "LocalSlot": "PrimitiveIdInput",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "PrimitiveId"
                    }
                }
            ],
            "PassData": {
                "$type": "FullscreenTrianglePassData",
                "ShaderAsset": {
