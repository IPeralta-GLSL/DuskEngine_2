#pragma once

struct LightTreeNodeData
{
    float3 m_bboxMin;
    float3 m_bboxMax;
    float3 m_coneAxis;
    float m_coneThetaO;
    float m_energy;
    uint m_leftChildIndex;
    uint m_rightChildIndex;
    uint m_lightIndex;
    uint m_lightCount;
};

float CalculateNodeImportance(LightTreeNodeData node, float3 queryPoint)
{
    float3 nodeCenter = (node.m_bboxMin + node.m_bboxMax) * 0.5;
    float3 nodeHalfSize = (node.m_bboxMax - node.m_bboxMin) * 0.5;

    float3 delta = queryPoint - nodeCenter;
    float distSqr = dot(delta, delta);

    float area = 2.0 * (nodeHalfSize.x * nodeHalfSize.y +
                        nodeHalfSize.y * nodeHalfSize.z +
                        nodeHalfSize.x * nodeHalfSize.z);

    float importance = node.m_energy * area / max(distSqr + area, 1e-4);

    float3 dirToNode = normalize(delta);
    float cosAngle = dot(dirToNode, node.m_coneAxis);
    float coneAttenuation = saturate((cosAngle - node.m_coneThetaO) / max(1.0 - node.m_coneThetaO, 1e-4));
    importance *= coneAttenuation;

    return importance;
}

bool IsLeafNode(LightTreeNodeData node)
{
    return node.m_lightCount > 0;
}
